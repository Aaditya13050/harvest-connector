{
  "name": "harvest-connector",
  "version": "1.0.0",
  "description": "A remote MCP connector that lets Claude and ChatGPT read and log Harvest time, run reports and draft invoices.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e.ts",
    "demo": "node test/demo.ts",
    "fake-harvest": "node test/fake-harvest-server.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
